{
  "name": "cadova",
  "displayName": "Cadova",
  "description": "Generate and preview Cadova models from VS Code.",
  "version": "0.1.0",
  "publisher": "tomasf",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomasf/cadova-vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:swift"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "cadova.preview",
        "displayName": "Cadova Preview",
        "selector": [
          {
            "filenamePattern": "*.3mf"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "cadova.buildModel",
        "title": "Generate Model",
        "category": "Cadova"
      },
      {
        "command": "cadova.buildAndPreviewModel",
        "title": "Generate and Preview Model",
        "category": "Cadova"
      },
      {
        "command": "cadova.rebuildPreview",
        "title": "Regenerate Model",
        "category": "Cadova",
        "icon": "$(refresh)"
      },
      {
        "command": "cadova.fitPreview",
        "title": "Fit Model in View",
        "category": "Cadova",
        "icon": "$(screen-full)"
      },
      {
        "command": "cadova.showAllParts",
        "title": "Show All Parts",
        "category": "Cadova",
        "icon": "$(eye)"
      },
      {
        "command": "cadova.hideAllParts",
        "title": "Hide All Parts",
        "category": "Cadova",
        "icon": "$(eye-closed)"
      },
      {
        "command": "cadova.centerOnParts",
        "title": "Center View",
        "category": "Cadova"
      },
      {
        "command": "cadova.showOnlyParts",
        "title": "Show Only",
        "category": "Cadova"
      },
      {
        "command": "cadova.copyPartNames",
        "title": "Copy Part Names",
        "category": "Cadova"
      },
      {
        "command": "cadova.partsSmallIcons",
        "title": "Use Small Icons",
        "category": "Cadova"
      },
      {
        "command": "cadova.partsLargeIcons",
        "title": "Use Large Icons",
        "category": "Cadova"
      },
      {
        "command": "cadova.copyMeasurement",
        "title": "Copy",
        "category": "Cadova"
      },
      {
        "command": "cadova.deleteMeasurement",
        "title": "Delete",
        "category": "Cadova"
      },
      {
        "command": "cadova.deleteAllMeasurements",
        "title": "Delete All Measurements",
        "category": "Cadova"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cadova.buildModel",
          "when": "false"
        },
        {
          "command": "cadova.buildAndPreviewModel",
          "when": "false"
        },
        {
          "command": "cadova.fitPreview",
          "when": "activeCustomEditorId == cadova.preview"
        },
        {
          "command": "cadova.rebuildPreview",
          "when": "activeCustomEditorId == cadova.preview"
        },
        {
          "command": "cadova.showAllParts",
          "when": "cadova.hasPreview"
        },
        {
          "command": "cadova.hideAllParts",
          "when": "cadova.hasPreview"
        },
        {
          "command": "cadova.centerOnParts",
          "when": "false"
        },
        {
          "command": "cadova.showOnlyParts",
          "when": "false"
        },
        {
          "command": "cadova.copyPartNames",
          "when": "false"
        },
        {
          "command": "cadova.partsSmallIcons",
          "when": "false"
        },
        {
          "command": "cadova.partsLargeIcons",
          "when": "false"
        },
        {
          "command": "cadova.copyMeasurement",
          "when": "false"
        },
        {
          "command": "cadova.deleteMeasurement",
          "when": "false"
        },
        {
          "command": "cadova.deleteAllMeasurements",
          "when": "cadova.hasPreview"
        }
      ],
      "editor/title": [
        {
          "command": "cadova.rebuildPreview",
          "when": "activeCustomEditorId == cadova.preview",
          "group": "navigation"
        },
        {
          "command": "cadova.fitPreview",
          "when": "activeCustomEditorId == cadova.preview",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "cadova.showAllParts",
          "when": "view == cadova.parts && cadova.hasHiddenParts",
          "group": "navigation"
        },
        {
          "command": "cadova.hideAllParts",
          "when": "view == cadova.parts && !cadova.hasHiddenParts",
          "group": "navigation"
        },
        {
          "command": "cadova.partsSmallIcons",
          "when": "view == cadova.parts && cadova.partsIconSize != small",
          "group": "1_size@1"
        },
        {
          "command": "cadova.partsLargeIcons",
          "when": "view == cadova.parts && cadova.partsIconSize == small",
          "group": "1_size@2"
        }
      ],
      "webview/context": [
        {
          "command": "cadova.centerOnParts",
          "when": "webviewId == cadova.parts && webviewSection == part",
          "group": "1_view@1"
        },
        {
          "command": "cadova.showOnlyParts",
          "when": "webviewId == cadova.parts && webviewSection == part",
          "group": "1_view@2"
        },
        {
          "command": "cadova.copyPartNames",
          "when": "webviewId == cadova.parts && webviewSection == part",
          "group": "2_copy@1"
        },
        {
          "command": "cadova.copyMeasurement",
          "when": "webviewId == cadova.parts && (webviewSection == measurement || webviewSection == coordinate)",
          "group": "1_edit@1"
        },
        {
          "command": "cadova.deleteMeasurement",
          "when": "webviewId == cadova.parts && webviewSection == measurement",
          "group": "1_edit@2"
        },
        {
          "command": "cadova.deleteAllMeasurements",
          "when": "webviewId == cadova.parts && (webviewSection == measurement || webviewSection == coordinate)",
          "group": "2_all@1"
        }
      ]
    },
    "configuration": {
      "title": "Cadova",
      "properties": {
        "cadova.swiftPath": {
          "type": "string",
          "default": "swift",
          "description": "The swift executable used to compile and run model packages."
        },
        "cadova.buildConfiguration": {
          "type": "string",
          "enum": [
            "debug",
            "release"
          ],
          "default": "debug",
          "description": "The configuration model packages are compiled with. Release takes longer to compile but generates complex models faster."
        },
        "cadova.rebuildOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Regenerate the models open in previews whenever a Swift file in their package is saved."
        },
        "cadova.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Generate and Preview actions above each model and project."
        }
      }
    },
    "keybindings": [
      {
        "command": "cadova.rebuildPreview",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "activeCustomEditorId == cadova.preview"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "cadova.parts",
          "name": "Model",
          "when": "cadova.hasPreview"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npx @vscode/vsce package",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "sync-viewer": "node scripts/sync-viewer.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/three": "^0.170.0",
    "@types/vscode": "~1.80.0",
    "esbuild": "^0.24.0",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.8.3",
    "typescript": "^5.6.3"
  }
}
